# ============================================================
# MIROFISH ENGINE - CONFIGURAÇÃO DE AMBIENTE (.env)
# ============================================================

# 1. Configuração do Provedor de LLM (Inference Layer)
# O MiroFish é compatível com qualquer provedor no formato OpenAI SDK.

# Exemplo A: OpenAI
# LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini

# Exemplo B: DeepSeek (Excelente custo-benefício para enxames grandes)
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-chat

# Exemplo C: Google Gemini (via OpenAI Compatibility)
# LLM_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL_NAME=gemini-1.5-flash

# Provedor ativo (insira sua chave aqui):
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# 2. Configuração de Memória & GraphRAG (Zep Cloud)
# Utilizado para indexação ontológica do Seed Material.
# Obtenha gratuitamente em: https://www.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# 3. Configurações de Rede
PORT=5001
FRONTEND_PORT=3000
